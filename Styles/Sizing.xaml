<?xml version="1.0" encoding="utf-8"?>

<!--
  ══ 尺寸与节奏令牌 ══

  为什么需要这一层：此前每个页面各自写 Height / MinHeight / Padding，
  同一行里混出 32 / 40 / 64 dip 三种控件高度（实测：ComboBox H=64 dip、Button H=32 dip、
  ToggleSwitch H=40 dip 并排），纵向基线也差 4–6 dip。对齐不是审美问题，
  是「同一行只有一个基线」的工程约束——所以高度只在这里定义一次。

  取值依据 WinUI 官方度量：
  · 控件默认高度 32（TextControlThemeMinHeight / ComboBoxMinHeight 都是 32）
  · 触控建议目标 ≥40（官方 7.5mm 参考），因此可点元素不低于 32，主操作 40
  · 列表项 40（ListViewItemMinHeight）或紧凑 32
  · 间距与圆角沿用 tokens.json 的 4 基数列

  硬规则：
  1) 控件只写 MinHeight，**不写 Height**——写死高度在 150% 缩放或用户放大文字时会裁掉文字。
  2) 同一行里的控件必须同高同基线，标签（Header）另起自己的行，不参与控件高度。
  3) 页面内不再出现字面量高度与内联 Padding。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="SkWindowMinWidth">960</x:Double>
    <x:Double x:Key="SkWindowMinHeight">640</x:Double>

    <!-- ══ 控件高度 ══ -->
    <x:Double x:Key="SkControlHeight">32</x:Double>
    <x:Double x:Key="SkControlHeightCompact">28</x:Double>
    <x:Double x:Key="SkControlHeightTouch">40</x:Double>
    <x:Double x:Key="SkToolbarHeight">40</x:Double>

    <!-- ══ 行高 ══ -->
    <x:Double x:Key="SkRowHeight">32</x:Double>
    <x:Double x:Key="SkRowHeightComfort">40</x:Double>
    <x:Double x:Key="SkHeaderRowHeight">32</x:Double>

    <!-- ══ 间距（4 基数列，与 tokens.json 的 space-* 对齐）══ -->
    <x:Double x:Key="SkGapTight">4</x:Double>
    <x:Double x:Key="SkGap">8</x:Double>
    <x:Double x:Key="SkGapLoose">12</x:Double>
    <x:Double x:Key="SkGutter">16</x:Double>
    <x:Double x:Key="SkGutterWide">24</x:Double>

    <!-- ══ 页面外边距：内容区统一一套，页面不再各写 ══ -->
    <Thickness x:Key="SkPagePadding">16,12,16,12</Thickness>
    <Thickness x:Key="SkToolbarPadding">0</Thickness>

    <!-- ══ 卡片/面板内边距 ══ -->
    <Thickness x:Key="SkCardPadding">16</Thickness>
    <Thickness x:Key="SkCardPaddingTight">12</Thickness>

    <!-- ══ 响应式断点（dip）══
         与 NavigationView 的 Auto 折叠阈值一致：1008 展开 / 641 紧凑。
         页面用它们决定工具栏折叠层级。 -->
    <x:Double x:Key="SkBreakpointWide">1200</x:Double>
    <x:Double x:Key="SkBreakpointMedium">900</x:Double>
    <x:Double x:Key="SkBreakpointNarrow">640</x:Double>

</ResourceDictionary>
