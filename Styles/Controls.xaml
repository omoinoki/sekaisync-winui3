<?xml version="1.0" encoding="utf-8"?>

<!--
  Signal Stage 的控件角色层。页面只引用这里的样式，不再逐处写 FontSize / Opacity / 十六进制。

  三条硬约束（ux-handbook §3.2–3.3 + WinUI 官方 typography / high-contrast 页）：
  1) 次要文字用 SkInkMutedBrush 配对色，**禁止**用 Opacity 表达「次要」——降透明度会让对比度失守。
  2) 字号一律挂在平台字阶上（Caption 12 / Body 14 / BodyStrong 14 SemiBold），
     不覆盖 FontFamily：中文回退交给系统主题字体（Segoe UI Variable → Microsoft YaHei UI），不随包分发字体。
     可读性下限：Regular 不低于 12，SemiBold 不低于 14。
  3) 列表行内的文字样式**不设 Foreground**：ListView 行有 hover/selected/高对比反色，
     显式前景会让选中行变成读不清的字。行内需要弱化时用 NoFg 变体 + 字号/字重区分。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ 文字角色（面板/详情区可用，带配对前景色）══ -->

    <Style x:Key="SkBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SkInkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SkStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SkInkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SkProseTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SkInkBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="LineStackingStrategy" Value="MaxHeight" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="SkMutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SkInkMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 小标题：手册的节奏来自序号、细分隔与留白，不来自倾斜或字距。SemiBold 下限 14。 -->
    <Style x:Key="SkSectionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SkInkMutedBrush}" />
    </Style>

    <Style x:Key="SkPageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SkInkBrush}" />
    </Style>

    <!-- 机读字段：ID / 路径 / 命令不本地化，用等宽。 -->
    <Style x:Key="SkMonoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SkInkMutedBrush}" />
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ══ 表格：行内变体一律不设 Foreground（见文件头第 3 条）══ -->

    <Style x:Key="SkTableHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SkInkMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SkTableCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- 表格单元不换行：宽度不足走省略号（第五批批示），行高才稳定。 -->
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 次要列：靠字号与行内位置区分，不靠颜色，选中行仍可读。 -->
    <Style x:Key="SkTableCellSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ══ 语义状态文字（面板区用；必须与文案同时出现，颜色不是唯一通道）══ -->
    <Style x:Key="SkSuccessTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SkSuccessBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SkWarningTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SkWarningBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SkDangerTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SkDangerBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SkUnknownTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SkUnknownBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ══ 状态胶囊：底色 + 前景配对，文字由页面提供。══
         accent 只用于编辑性标签，不得编码来源可信度或核验结论（§3.2 / §6）。 -->
    <Style x:Key="SkChipBaseStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource SkChipCornerRadius}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SkChipTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SkSuccessChipStyle" TargetType="Border" BasedOn="{StaticResource SkChipBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource SkSuccessSoftBrush}" />
    </Style>

    <Style x:Key="SkWarningChipStyle" TargetType="Border" BasedOn="{StaticResource SkChipBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource SkWarningSoftBrush}" />
    </Style>

    <Style x:Key="SkDangerChipStyle" TargetType="Border" BasedOn="{StaticResource SkChipBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource SkDangerSoftBrush}" />
    </Style>

    <Style x:Key="SkUnknownChipStyle" TargetType="Border" BasedOn="{StaticResource SkChipBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource SkUnknownSoftBrush}" />
    </Style>

    <Style x:Key="SkSelectionChipStyle" TargetType="Border" BasedOn="{StaticResource SkChipBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource SkSelectionBrush}" />
    </Style>

    <Style x:Key="SkAccentChipStyle" TargetType="Border" BasedOn="{StaticResource SkChipBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource SkAccentSoftBrush}" />
    </Style>

    <!-- 内容面与装饰分隔采用实色，避免壁纸或透明度改变阅读对比。 -->
    <Style x:Key="SkPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SkSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SkHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SkPanelCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="SkMutedPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SkSurfaceMutedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SkHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SkPanelCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="SkHairlineStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SkHairlineBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ══ 空态/异常区：事实 + 影响 + 下一步（§6 文案契约），一处一处用，不做通用控件。 -->
    <Style x:Key="SkStatePanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Margin" Value="24" />
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         工具条与标签：解决「同一行控件高度不一致」
         ──────────────────────────────────────────────────────────────────────
         ComboBox 的 Header 会把标签文字叠在控件上方，于是带 Header 的控件自然高 64 dip，
        与同排 32 dip 的按钮混在一起 → 基线永远对不齐（实测）。
         改为「左置标签 + AutomationProperties.LabeledBy」：控件同高、标签可见、
         读屏仍拿到控件名（官方推荐 LabeledBy 而非复制字符串）。
         ══════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="SkInlineLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SkInkMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- 32 DIP 是下限而非固定高度，放大文字时保留完整内容。 -->
    <Style x:Key="SkToolbarComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="SkToolbarTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="32" />
        <!-- 上下 padding 不为 0：单行 TextBox 的文字基线由 ContentElement 的 Margin 决定，
             纯 0,0 会让 placeholder/正文贴顶（实测第四批截图批示）。 -->
        <Setter Property="Padding" Value="10,4,10,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SkToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 主操作按钮：同样的高度与内边距，只换配色（AccentButtonStyle 的 Padding 自带一份，需覆盖）。 -->
    <Style x:Key="SkToolbarAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 工具条里的标签与分隔线：与 40 dip 控件同一基线。 -->

    <Style x:Key="SkToolbarDividerStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Background" Value="{ThemeResource SkHairlineBrush}" />
    </Style>

    <!-- ══ 页面标题：品牌的主要落点 ══
         手册把「内容标题、选择色、空态」列为品牌可进入的位置。标题用左侧色条 + 渐变下划线，
         颜色只做识别，不承载状态。 -->
    <Style x:Key="SkPageHeadingStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SkInkBrush}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SkPageSubheadingStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SkInkMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 标题左侧的色条：3×22，青→粉渐变，是整页最醒目的一处品牌信号。 -->
    <Style x:Key="SkHeadingAccentStyle" TargetType="Border">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Background" Value="{ThemeResource SkBrandGradientBrush}" />
    </Style>

    <!-- 标题下的整条渐变细线：从青过渡到粉再淡出，给页面一个「章节开场」的节奏。 -->
    <Style x:Key="SkHeadingRuleStyle" TargetType="Border">
        <Setter Property="Height" Value="3" />
        <Setter Property="CornerRadius" Value="1.5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Background" Value="{ThemeResource SkBrandRuleBrush}" />
    </Style>

    <!-- ══ 详情卡展开区：标题即开关 ══
         内容面板里不再放第二层卡片：Expander 透明、无边框，展开内容直接落在面板里，
         视觉上只是「标题可展开」，不是又一个嵌套容器。 -->
    <Style x:Key="SkDetailExpanderStyle" TargetType="Expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <!-- HorizontalContentAlignment 必须 Stretch：Left 会让展开区内容按固有宽度排，
             内部 Grid 的 * 列塌掉，右锚定的按钮永远贴不到面板右缘（第五批实测）。 -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style x:Key="SkWorkspaceHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SkPageHeadingStyle}" />

    <Style x:Key="SkWorkspaceComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="SkWorkspaceTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SkWorkspaceButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SkWorkspaceAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
