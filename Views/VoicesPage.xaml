<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SekaiSync.Desktop.Views.VoicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SekaiSync.Desktop.Controls"
    xmlns:models="using:SekaiSync.Desktop.Models"
    xmlns:services="using:SekaiSync.Desktop.Services"
    xmlns:views="using:SekaiSync.Desktop.Views"
    xmlns:vm="using:SekaiSync.Desktop.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="台词" Style="{StaticResource SkWorkspaceHeadingStyle}" />
            <Border Style="{StaticResource SkHeadingRuleStyle}" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            Margin="0,8,0,0"
            Visibility="{x:Bind BoolToVisibility(ViewModel.ShowMoesekaiGap), Mode=OneWay}"
            IsOpen="{x:Bind ViewModel.ShowMoesekaiGap, Mode=OneWay}"
            Severity="Warning"
            Title="{x:Bind ViewModel.MoesekaiGapTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.MoesekaiGapMessage, Mode=OneWay}"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False" />

        <ItemsControl
            Grid.Row="2"
            Margin="0,8,0,0"
            AutomationProperties.Name="台词类型（可多选）"
            ItemsSource="{x:Bind ViewModel.Kinds, Mode=OneTime}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:WrapPanel RowSpacing="4" ColumnSpacing="16" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:VoiceKindOption">
                    <CheckBox
                        MinWidth="0"
                        MinHeight="32"
                        Content="{x:Bind DisplayName}"
                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                        IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind DisplayName}"
                        AutomationProperties.HelpText="{x:Bind DisabledReason, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind DisabledReason, Mode=OneWay}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 下拉标签及搜索按钮随各自的控件成组换行。 -->
        <Grid Grid.Row="3" ColumnSpacing="12" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:WrapPanel RowSpacing="8" ColumnSpacing="8" VerticalAlignment="Top">
                <Grid Width="188" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="InstanceLabel" Text="实例" Margin="0" Style="{StaticResource SkInlineLabelStyle}" />
                    <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource SkWorkspaceComboBoxStyle}"
                        ItemsSource="{x:Bind ViewModel.InstanceOptions, Mode=OneTime}"
                        SelectedItem="{x:Bind ViewModel.SelectedInstance, Mode=TwoWay}"
                        AutomationProperties.LabeledBy="{x:Bind InstanceLabel}"
                        ToolTipService.ToolTip="合并两个实例；相同对齐键优先使用 Sekai Viewer。"
                        AutomationProperties.HelpText="合并两个实例；相同对齐键优先使用 Sekai Viewer。">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="services:InstanceOption">
                                <TextBlock Text="{x:Bind views:VoicesPage.InstanceDisplayName(Filter)}" ToolTipService.ToolTip="{x:Bind Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Grid Width="188" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VersionLabel" Text="版本" Margin="0" Style="{StaticResource SkInlineLabelStyle}" />
                    <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource SkWorkspaceComboBoxStyle}"
                        ItemsSource="{x:Bind ViewModel.VersionOptions, Mode=OneTime}"
                        SelectedItem="{x:Bind ViewModel.SelectedVersion, Mode=TwoWay}"
                        AutomationProperties.LabeledBy="{x:Bind VersionLabel}"
                        AutomationProperties.HelpText="按区服筛选" />
                </Grid>
                <Grid Width="280" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="SearchBox"
                        MinWidth="0"
                        Style="{StaticResource SkWorkspaceTextBoxStyle}"
                        AutomationProperties.Name="台词搜索框"
                        AutomationProperties.HelpText="{x:Bind ViewModel.SearchScopeHint, Mode=OneTime}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SearchScopeHint, Mode=OneTime}"
                        PlaceholderText="搜索标题或 ID"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        KeyDown="SearchBox_KeyDown" />
                    <Button Grid.Column="1" Content="搜索" Style="{StaticResource SkWorkspaceAccentButtonStyle}" Command="{x:Bind ViewModel.SearchCommand}" />
                </Grid>
            </controls:WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Content="刷新" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}" />
                <ProgressRing
                    Width="24" Height="24"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="正在读取台词"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind BoolToVisibility(ViewModel.IsLoading), Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,8,0,0" Spacing="4">
            <controls:WrapPanel RowSpacing="4" ColumnSpacing="8">
                <Button Content="首页" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.FirstPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}" />
                <Button Content="上一页" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.PreviousPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}" />
                <Button Content="下一页" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.NextPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}" />
                <Button Content="末页" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.LastPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}" />
                <TextBlock
                    Text="{x:Bind ViewModel.PagerText, Mode=OneWay}"
                    Style="{StaticResource SkMutedTextStyle}"
                    AutomationProperties.LiveSetting="Polite" />
            </controls:WrapPanel>
            <TextBlock
                Text="{x:Bind ViewModel.Attention, Mode=OneWay}"
                TextWrapping="Wrap"
                Style="{StaticResource SkWarningTextStyle}"
                Visibility="{x:Bind BoolToVisibility(ViewModel.HasAttention), Mode=OneWay}"
                AutomationProperties.LiveSetting="Polite" />
            <TextBlock
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Style="{StaticResource SkMutedTextStyle}"
                Visibility="{x:Bind BoolToVisibility(ViewModel.HasStatusText), Mode=OneWay}"
                AutomationProperties.Name="已提交的搜索"
                AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <Grid Grid.Row="5" ColumnSpacing="0" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="*" />
                <ColumnDefinition Width="Auto" />
                <!-- 1 : 1.15 ≈ 0.465，落在手柄限界 0.27–0.47 内：列表首行 p95 约 357 DIP。 -->
                <ColumnDefinition x:Name="DetailColumn" Width="1.15*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SkPanelStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        MinHeight="36"
                        ColumnSpacing="8"
                        BorderBrush="{ThemeResource SkHairlineBrush}"
                        Background="{ThemeResource SkSurfaceMutedBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="说话人 / 台词" Style="{StaticResource SkTableHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="版本" Style="{StaticResource SkTableHeaderTextStyle}" />
                    </Grid>
                    <ListView
                        Grid.Row="1"
                        AutomationProperties.Name="台词列表"
                        SelectionMode="Single"
                        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:VoiceRow">
                                <Grid
                                    Padding="0,8"
                                    ColumnSpacing="8"
                                    RowSpacing="4"
                                    Background="Transparent"
                                    AutomationProperties.Name="{x:Bind RowAccessibleName}"
                                    ToolTipService.ToolTip="{x:Bind RowAccessibleName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Text="{x:Bind views:VoicesPage.SpeakerDisplayName(Speaker)}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind RegionLabel}" Style="{StaticResource SkTableCellSecondaryTextStyle}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Text="{x:Bind Text}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Text="{x:Bind views:VoicesPage.RowMetadata(KindDisplay, InstanceBadge, CrawledLabel)}"
                                        Style="{StaticResource SkTableCellSecondaryTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="60" />
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource SkSurfaceBrush}"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.ShowListOverlay), Mode=OneWay}">
                        <StackPanel Style="{StaticResource SkStatePanelStyle}">
                            <TextBlock
                                Text="{x:Bind ViewModel.ListStateTitle, Mode=OneWay}"
                                TextAlignment="Center"
                                Style="{StaticResource SkStrongTextStyle}"
                                Visibility="{x:Bind BoolToVisibility(ViewModel.ShowListStateInfo), Mode=OneWay}"
                                AutomationProperties.LiveSetting="Polite" />
                            <TextBlock
                                Text="{x:Bind ViewModel.ListStateTitle, Mode=OneWay}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Style="{StaticResource SkDangerTextStyle}"
                                Visibility="{x:Bind BoolToVisibility(ViewModel.ShowListStateFailure), Mode=OneWay}"
                                AutomationProperties.LiveSetting="Polite" />
                            <TextBlock
                                Text="{x:Bind ViewModel.ListStateHint, Mode=OneWay}"
                                TextAlignment="Center"
                                Style="{StaticResource SkMutedTextStyle}"
                                AutomationProperties.LiveSetting="Polite" />
                            <controls:WrapPanel RowSpacing="4" ColumnSpacing="8" HorizontalAlignment="Center">
                                <Button Content="清除筛选" Command="{x:Bind ViewModel.ClearFilterCommand}" Visibility="{x:Bind BoolToVisibility(ViewModel.ShowListClearFilter), Mode=OneWay}" />
                                <Button Content="重试" Command="{x:Bind ViewModel.RefreshCommand}" Visibility="{x:Bind BoolToVisibility(ViewModel.ShowListRetry), Mode=OneWay}" />
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <controls:ColumnSplitHandle
                Grid.Column="1"
                Left="{x:Bind ListColumn}" Right="{x:Bind DetailColumn}"
                MinRatio="0.27" MaxRatio="0.47" SettingsKey="voices" />
            <Border Grid.Column="2" Style="{StaticResource SkPanelStyle}" Padding="16,12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="{x:Bind ViewModel.DetailSpeaker, Mode=OneWay}"
                            Style="{StaticResource SkStrongTextStyle}"
                            TextWrapping="Wrap"
                            MaxLines="3"
                            TextTrimming="CharacterEllipsis"
                            IsTextSelectionEnabled="True"
                            ToolTipService.ToolTip="{x:Bind ViewModel.DetailSpeaker, Mode=OneWay}" />
                        <Expander
                            Style="{StaticResource SkDetailExpanderStyle}"
                            IsExpanded="False"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.HasSelection), Mode=OneWay}"
                            AutomationProperties.Name="来源与标识">
                            <Expander.Header>
                                <TextBlock Margin="0,4" Text="{x:Bind ViewModel.DetailMeta, Mode=OneWay}" Style="{StaticResource SkMutedTextStyle}" />
                            </Expander.Header>
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                <!-- 左 16 与头部文字对齐（样式把模板的 16 内容内边距归零了）。 -->
                                <StackPanel Spacing="4" Padding="16,16,16,12">
                                    <TextBlock Text="{x:Bind ViewModel.DetailCrawledLabel, Mode=OneWay}" Style="{StaticResource SkMutedTextStyle}" />
                                    <TextBlock Text="对齐键" Style="{StaticResource SkMutedTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.DetailAlignmentKey, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource SkMonoTextStyle}" />
                                    <TextBlock Text="稳定 ID" Style="{StaticResource SkMutedTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.DetailStableId, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource SkMonoTextStyle}" />
                                    <controls:WrapPanel RowSpacing="4" ColumnSpacing="8">
                                        <Button Content="复制对齐键" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.CopyAlignmentKeyCommand}" AutomationProperties.Name="复制这条台词的对齐键到剪贴板" />
                                        <Button Content="复制稳定 ID" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.CopyStableIdCommand}" AutomationProperties.Name="复制这条台词的稳定 ID 到剪贴板" />
                                    </controls:WrapPanel>
                                    <TextBlock
                                        Text="{x:Bind ViewModel.CopyNote, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Style="{StaticResource SkSuccessTextStyle}"
                                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasCopyNote), Mode=OneWay}"
                                        AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <!-- 滚动容器直接占用星号行，避免纵向 StackPanel 无限测量。 -->
                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Disabled"
                            HorizontalContentAlignment="Stretch"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.HasSelection), Mode=OneWay}">
                            <StackPanel Spacing="8" Margin="0,0,12,0">
                                <TextBlock Text="{x:Bind ViewModel.DetailText, Mode=OneWay}" IsTextSelectionEnabled="True" Style="{StaticResource SkProseTextStyle}" />
                                <controls:WrapPanel RowSpacing="4" ColumnSpacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.ParallelScopeLabel, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource SkSectionTextStyle}" />
                                    <Button Content="重试对照" Command="{x:Bind ViewModel.RetryColumnsCommand}" Visibility="{x:Bind BoolToVisibility(ViewModel.ShowParallelNotice), Mode=OneWay}" />
                                </controls:WrapPanel>
                                <TextBlock
                                    Text="{x:Bind ViewModel.ParallelNoticeText, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource SkUnknownTextStyle}"
                                    Visibility="{x:Bind BoolToVisibility(ViewModel.ShowParallelNotice), Mode=OneWay}"
                                    AutomationProperties.LiveSetting="Polite" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Columns, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ParallelColumn">
                                            <Border Margin="0,0,0,8" Padding="12,8" Style="{StaticResource SkMutedPanelStyle}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{x:Bind Header}" Style="{StaticResource SkStrongTextStyle}" />
                                                    <TextBlock
                                                        Text="{x:Bind MissingLabel}"
                                                        TextWrapping="Wrap"
                                                        Style="{StaticResource SkMutedTextStyle}"
                                                        Visibility="{x:Bind MissingVisibility}" />
                                                    <ItemsControl ItemsSource="{x:Bind Blocks}" Visibility="{x:Bind ContentVisibility}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:DialogueBlock">
                                                                <TextBlock Text="{x:Bind Text}" IsTextSelectionEnabled="True" Style="{StaticResource SkProseTextStyle}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Background="{ThemeResource SkSurfaceBrush}" Visibility="{x:Bind BoolToVisibility(ViewModel.ShowDetailEmpty), Mode=OneWay}">
                            <StackPanel Style="{StaticResource SkStatePanelStyle}">
                                <TextBlock Text="选择一条台词" TextAlignment="Center" Style="{StaticResource SkStrongTextStyle}" />
                                <TextBlock Text="从左侧列表查看正文与五服对照。" TextAlignment="Center" Style="{StaticResource SkMutedTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
