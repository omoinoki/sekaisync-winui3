<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SekaiSync.Desktop.Views.StoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SekaiSync.Desktop.Controls"
    xmlns:models="using:SekaiSync.Desktop.Models"
    xmlns:services="using:SekaiSync.Desktop.Services"
    xmlns:views="using:SekaiSync.Desktop.Views"
    xmlns:vm="using:SekaiSync.Desktop.ViewModels"
    mc:Ignorable="d">

    <Grid RowSpacing="8"
            KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="FindAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="剧情" Style="{StaticResource SkWorkspaceHeadingStyle}" />
            <Border Style="{StaticResource SkHeadingRuleStyle}" />
        </StackPanel>

        <ItemsControl
            Grid.Row="1"
            AutomationProperties.Name="剧情类型（可多选）"
            ItemsSource="{x:Bind ViewModel.Kinds, Mode=OneTime}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:WrapPanel RowSpacing="4" ColumnSpacing="16" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StoryKindOption">
                    <CheckBox
                        MinWidth="0"
                        MinHeight="32"
                        Content="{x:Bind DisplayName}"
                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 每组独立换行，标签不离开下拉框，搜索按钮不离开输入框。 -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:WrapPanel RowSpacing="8" ColumnSpacing="8" VerticalAlignment="Top">
                <Grid Width="188" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="InstanceLabel" Text="实例" Margin="0" Style="{StaticResource SkInlineLabelStyle}" />
                    <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource SkWorkspaceComboBoxStyle}"
                        ItemsSource="{x:Bind ViewModel.InstanceOptions, Mode=OneTime}"
                        SelectedItem="{x:Bind ViewModel.SelectedInstance, Mode=TwoWay}"
                        AutomationProperties.LabeledBy="{x:Bind InstanceLabel}"
                        ToolTipService.ToolTip="合并两个实例；相同对齐键优先使用 Sekai Viewer。"
                        AutomationProperties.HelpText="合并两个实例；相同对齐键优先使用 Sekai Viewer。">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="services:InstanceOption">
                                <TextBlock Text="{x:Bind views:StoryPage.InstanceDisplayName(Filter)}" ToolTipService.ToolTip="{x:Bind Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Grid Width="188" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VersionLabel" Text="版本" Margin="0" Style="{StaticResource SkInlineLabelStyle}" />
                    <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource SkWorkspaceComboBoxStyle}"
                        ItemsSource="{x:Bind ViewModel.VersionOptions, Mode=OneTime}"
                        SelectedItem="{x:Bind ViewModel.SelectedVersion, Mode=TwoWay}"
                        AutomationProperties.LabeledBy="{x:Bind VersionLabel}"
                        AutomationProperties.HelpText="按区服筛选" />
                </Grid>
                <Grid Width="280" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="SearchBox"
                        MinWidth="0"
                        Style="{StaticResource SkWorkspaceTextBoxStyle}"
                        AutomationProperties.Name="剧情搜索框"
                        AutomationProperties.HelpText="{x:Bind ViewModel.SearchScopeHint, Mode=OneTime}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SearchScopeHint, Mode=OneTime}"
                        PlaceholderText="搜索标题或 ID"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        KeyDown="SearchBox_KeyDown" />
                    <Button Grid.Column="1" Content="搜索" Style="{StaticResource SkWorkspaceAccentButtonStyle}" Command="{x:Bind ViewModel.SearchCommand}" />
                </Grid>
                <CheckBox
                    Content="仅未译"
                    MinWidth="0"
                    MinHeight="32"
                    IsChecked="{x:Bind ViewModel.OnlyUntranslated, Mode=TwoWay}"
                    AutomationProperties.Name="仅显示未翻译的剧情" />
            </controls:WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Content="刷新" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}" />
                <ProgressRing
                    Width="24" Height="24"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="正在读取剧情"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind BoolToVisibility(ViewModel.IsLoading), Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="4">
            <controls:WrapPanel RowSpacing="4" ColumnSpacing="8">
                <Button Content="首页" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.FirstPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}" />
                <Button Content="上一页" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.PreviousPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}" />
                <Button Content="下一页" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.NextPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}" />
                <Button Content="末页" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.LastPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}" />
                <TextBlock
                    Text="{x:Bind ViewModel.PagerText, Mode=OneWay}"
                    Style="{StaticResource SkMutedTextStyle}"
                    AutomationProperties.LiveSetting="Polite" />
            </controls:WrapPanel>
            <TextBlock
                Text="{x:Bind ViewModel.Attention, Mode=OneWay}"
                TextWrapping="Wrap"
                Style="{StaticResource SkWarningTextStyle}"
                Visibility="{x:Bind BoolToVisibility(ViewModel.HasAttention), Mode=OneWay}"
                AutomationProperties.LiveSetting="Polite" />
            <TextBlock
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Style="{StaticResource SkMutedTextStyle}"
                Visibility="{x:Bind BoolToVisibility(ViewModel.HasStatusText), Mode=OneWay}"
                AutomationProperties.Name="已提交的搜索"
                AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- 列间距归零：分栏带宽度全部由手柄自己的 14+2+2 决定，与资讯页一致。 -->
        <Grid Grid.Row="4" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="*" />
                <ColumnDefinition Width="Auto" />
                <!-- 1 : 1.9 ≈ 0.345，落在手柄限界 0.24–0.38 内：右栏要留给固定 320 DIP 宽的对照栏。 -->
                <ColumnDefinition x:Name="DetailColumn" Width="1.9*" />
            </Grid.ColumnDefinitions>

            <!-- 列表 -->
            <Border Grid.Column="0" Style="{StaticResource SkPanelStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        MinHeight="36"
                        ColumnSpacing="8"
                        BorderBrush="{ThemeResource SkHairlineBrush}"
                        Background="{ThemeResource SkSurfaceMutedBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="标题" Style="{StaticResource SkTableHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="版本" Style="{StaticResource SkTableHeaderTextStyle}" />
                    </Grid>

                    <ListView
                        Grid.Row="1"
                        AutomationProperties.Name="剧情列表"
                        SelectionMode="Single"
                        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:StoryRow">
                                <Grid
                                    MinHeight="60"
                                    Padding="0,8"
                                    ColumnSpacing="8"
                                    RowSpacing="4"
                                    Background="Transparent"
                                    AutomationProperties.Name="{x:Bind RowAccessibleName}"
                                    ToolTipService.ToolTip="{x:Bind RowAccessibleName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind RegionLabel}" VerticalAlignment="Top" Style="{StaticResource SkTableCellSecondaryTextStyle}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Text="{x:Bind views:StoryPage.RowMetadata(KindDisplay, InstanceBadge, TranslationLabel, CrawledLabel)}"
                                        Style="{StaticResource SkTableCellSecondaryTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="34" />
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <!-- 列表区四态覆盖层：空库 / 库里没有 / 筛选排空 / 未选类型 / 读取失败（S-6） -->
                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource SkSurfaceBrush}"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.ShowListOverlay), Mode=OneWay}">
                        <StackPanel Style="{StaticResource SkStatePanelStyle}">
                            <TextBlock
                                Text="{x:Bind ViewModel.ListStateTitle, Mode=OneWay}"
                                TextAlignment="Center"
                                Style="{StaticResource SkStrongTextStyle}"
                                Visibility="{x:Bind BoolToVisibility(ViewModel.ShowListStateInfo), Mode=OneWay}"
                                AutomationProperties.LiveSetting="Polite" />
                            <TextBlock
                                Text="{x:Bind ViewModel.ListStateTitle, Mode=OneWay}"
                                TextAlignment="Center"
                                Style="{StaticResource SkDangerTextStyle}"
                                Visibility="{x:Bind BoolToVisibility(ViewModel.ShowListStateFailure), Mode=OneWay}"
                                AutomationProperties.LiveSetting="Polite" />
                            <TextBlock
                                Text="{x:Bind ViewModel.ListStateHint, Mode=OneWay}"
                                TextAlignment="Center"
                                Style="{StaticResource SkMutedTextStyle}"
                                AutomationProperties.LiveSetting="Polite" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Button
                                    Content="清除筛选"
                                    Command="{x:Bind ViewModel.ClearFilterCommand}"
                                    Visibility="{x:Bind BoolToVisibility(ViewModel.ShowListClearFilter), Mode=OneWay}" />
                                <Button
                                    Content="重试"
                                    Command="{x:Bind ViewModel.RefreshCommand}"
                                    Visibility="{x:Bind BoolToVisibility(ViewModel.ShowListRetry), Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <controls:ColumnSplitHandle
                Grid.Column="1"
                Left="{x:Bind ListColumn}" Right="{x:Bind DetailColumn}"
                MinRatio="0.24" MaxRatio="0.38" SettingsKey="story" />

            <!-- 详情：元信息 + 对白 + 对照 -->
            <Border
                Grid.Column="2"
                Style="{StaticResource SkPanelStyle}"
                Padding="16,12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="4">
                        <!-- 标题独占受约束的整行，不与元信息或展开按钮争宽。 -->
                        <TextBlock
                            Text="{x:Bind ViewModel.DetailHeader, Mode=OneWay}"
                            Style="{StaticResource SkStrongTextStyle}"
                            TextWrapping="Wrap"
                            MaxLines="3"
                            TextTrimming="CharacterEllipsis"
                            IsTextSelectionEnabled="True"
                            ToolTipService.ToolTip="{x:Bind ViewModel.DetailHeader, Mode=OneWay}" />
                        <Expander
                            Style="{StaticResource SkDetailExpanderStyle}"
                            IsExpanded="False"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.HasDetail), Mode=OneWay}"
                            AutomationProperties.Name="来源与标识">
                            <Expander.Header>
                                <TextBlock
                                    Margin="0,4"
                                    Text="{x:Bind ViewModel.DetailMeta, Mode=OneWay}"
                                    Style="{StaticResource SkMutedTextStyle}" />
                            </Expander.Header>
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                <!-- 左 16 与头部文字对齐：SkDetailExpanderStyle 把 Padding 归零，
                                     模板的 ExpanderContentPadding(16) 不再生效，头部仍留 16 缩进。 -->
                                <StackPanel Spacing="4" Padding="16,16,16,12">
                                    <TextBlock Text="{x:Bind ViewModel.DetailTranslationLabel, Mode=OneWay}" Style="{StaticResource SkMutedTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.DetailCrawledLabel, Mode=OneWay}" Style="{StaticResource SkMutedTextStyle}" />
                                    <TextBlock Text="对齐键" Style="{StaticResource SkMutedTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.DetailAlignmentKey, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource SkMonoTextStyle}" />
                                    <TextBlock Text="稳定 ID" Style="{StaticResource SkMutedTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.DetailStableId, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource SkMonoTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.DetailUrl, Mode=OneWay}" Style="{StaticResource SkMonoTextStyle}" />
                                    <controls:WrapPanel RowSpacing="4" ColumnSpacing="8">
                                        <Button
                                            Content="复制对齐键"
                                            Style="{StaticResource SkWorkspaceButtonStyle}"
                                            Command="{x:Bind ViewModel.CopyAlignmentKeyCommand}"
                                            AutomationProperties.Name="复制对齐键到剪贴板" />
                                        <Button
                                            Content="复制稳定 ID"
                                            Style="{StaticResource SkWorkspaceButtonStyle}"
                                            Command="{x:Bind ViewModel.CopyStableIdCommand}"
                                            AutomationProperties.Name="复制这条剧情的稳定 ID 到剪贴板" />
                                    </controls:WrapPanel>
                                    <TextBlock
                                        Text="{x:Bind ViewModel.CopyNote, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Style="{StaticResource SkSuccessTextStyle}"
                                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasCopyNote), Mode=OneWay}"
                                        AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>

                    <controls:WrapPanel Grid.Row="1" RowSpacing="4" ColumnSpacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ReadingModeLabel" Text="阅读模式" Margin="0" Style="{StaticResource SkInlineLabelStyle}" />
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource SkWorkspaceComboBoxStyle}"
                                ItemsSource="{x:Bind ViewModel.ReadingModes, Mode=OneTime}"
                                SelectedItem="{x:Bind ViewModel.SelectedReadingMode, Mode=TwoWay}"
                                AutomationProperties.LabeledBy="{x:Bind ReadingModeLabel}"
                                ToolTipService.ToolTip="按对齐键对照其他区服的正文"
                                AutomationProperties.HelpText="按对齐键对照其他区服的正文" />
                        </Grid>
                        <TextBlock
                            Text="{x:Bind ViewModel.DetailBlockLabel, Mode=OneWay}"
                            Style="{StaticResource SkMutedTextStyle}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.DetailQualityLabel, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Style="{StaticResource SkWarningTextStyle}"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.HasDetailQuality), Mode=OneWay}" />
                    </controls:WrapPanel>

                    <Grid Grid.Row="2">
                        <!-- 单语正文：只纵向滚，文本按视口宽换行。 -->
                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.ShowSingleBody), Mode=OneWay}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DetailBlocks, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DialogueBlock">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock
                                                    Text="{x:Bind Speaker}"
                                                    Visibility="{x:Bind SpeakerVisibility}"
                                                    Style="{StaticResource SkStrongTextStyle}" />
                                                <TextBlock
                                                        Text="{x:Bind Text}"
                                                        Visibility="{x:Bind SpeechVisibility}"
                                                        Style="{StaticResource SkProseTextStyle}" />
                                                    <!-- 旁白（无冒号行）单独样式（S-10）：左细规则 + 缩进。
                                                        手册 §3.1 明令「不要倾斜文本」，且 CJK 斜体是合成倾斜、更难读。
                                                        规则用 Border 包一层：WinUI 3 的 TextBlock 没有 BorderBrush/BorderThickness。 -->
                                                    <Border
                                                            Margin="16,0,0,0"
                                                            Padding="10,0,0,0"
                                                            BorderThickness="2,0,0,0"
                                                            BorderBrush="{ThemeResource SkBorderBrush}"
                                                            Visibility="{x:Bind NarrationVisibility}">
                                                        <TextBlock
                                                                Text="{x:Bind Text}"
                                                                Style="{StaticResource SkProseTextStyle}" />
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                        </ScrollViewer>

                        <!-- 对照：范围标签固定在上方，栏区自身双向滚动——
                             X 条与 Y 条同属这一个 ScrollViewer，不再嵌一层。 -->
                        <Grid RowSpacing="6"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.ShowParallelColumns), Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="6">
                                <controls:WrapPanel RowSpacing="4" ColumnSpacing="8">
                                    <TextBlock
                                            Text="{x:Bind ViewModel.ParallelScopeLabel, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource SkSectionTextStyle}" />
                                        <Button
                                                Content="重试对照"
                                                Command="{x:Bind ViewModel.RetryColumnsCommand}"
                                                Visibility="{x:Bind BoolToVisibility(ViewModel.ShowParallelNotice), Mode=OneWay}" />
                                        </controls:WrapPanel>
                                        <TextBlock
                                                Text="{x:Bind ViewModel.ParallelNoticeText, Mode=OneWay}"
                                                TextWrapping="Wrap"
                                                Style="{StaticResource SkUnknownTextStyle}"
                                                Visibility="{x:Bind BoolToVisibility(ViewModel.ShowParallelNotice), Mode=OneWay}"
                                                AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <ScrollViewer
                                x:Name="ParallelScroller" Grid.Row="1"
                                HorizontalScrollBarVisibility="Visible" HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Columns, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ParallelColumn">
                                            <Border
                                                    Width="320"
                                                    Margin="0,0,10,0"
                                                    Padding="12,10"
                                                    Style="{StaticResource SkMutedPanelStyle}">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="{x:Bind Header}" Style="{StaticResource SkStrongTextStyle}" />
                                                    <TextBlock
                                                            Text="{x:Bind MissingLabel}"
                                                            TextWrapping="Wrap"
                                                            Style="{StaticResource SkMutedTextStyle}"
                                                            Visibility="{x:Bind MissingVisibility}" />
                                                        <ItemsControl ItemsSource="{x:Bind Blocks}" Visibility="{x:Bind ContentVisibility}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:DialogueBlock">
                                                                    <StackPanel Margin="0,0,0,6">
                                                                        <TextBlock
                                                                                Text="{x:Bind Speaker}"
                                                                                Visibility="{x:Bind SpeakerVisibility}"
                                                                                Style="{StaticResource SkStrongTextStyle}" />
                                                                            <TextBlock
                                                                                    Text="{x:Bind Text}"
                                                                                    Visibility="{x:Bind SpeechVisibility}"
                                                                                    Style="{StaticResource SkProseTextStyle}" />
                                                                                <!-- 对照栏里的旁白同样用左细规则（Border 包一层），不斜体（§3.1） -->
                                                                                <Border
                                                                                        Margin="16,0,0,0"
                                                                                        Padding="10,0,0,0"
                                                                                        BorderThickness="2,0,0,0"
                                                                                        BorderBrush="{ThemeResource SkBorderBrush}"
                                                                                        Visibility="{x:Bind NarrationVisibility}">
                                                                                    <TextBlock
                                                                                            Text="{x:Bind Text}"
                                                                                            Style="{StaticResource SkProseTextStyle}" />
                                                                                    </Border>
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- 加载态（S-2：IsDetailLoading 以前是死属性） -->
                        <Border
                            Background="{ThemeResource SkSurfaceBrush}"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.IsDetailLoading), Mode=OneWay}">
                            <StackPanel Style="{StaticResource SkStatePanelStyle}">
                                <ProgressRing
                                    Width="28" Height="28"
                                    HorizontalAlignment="Center"
                                    IsActive="{x:Bind ViewModel.IsDetailLoading, Mode=OneWay}" />
                                <TextBlock
                                    Text="正在读取正文…"
                                    TextAlignment="Center"
                                    Style="{StaticResource SkMutedTextStyle}"
                                    AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>

                        <!-- 空态 -->
                        <Border
                            Background="{ThemeResource SkSurfaceBrush}"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.ShowDetailEmpty), Mode=OneWay}">
                            <StackPanel Style="{StaticResource SkStatePanelStyle}">
                                <TextBlock
                                    Text="选择一条剧情"
                                    TextAlignment="Center"
                                    Style="{StaticResource SkStrongTextStyle}" />
                                <TextBlock
                                    Text="从左侧列表查看正文与对照。"
                                    TextAlignment="Center"
                                    Style="{StaticResource SkMutedTextStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- 失败态 -->
                        <Border
                            Background="{ThemeResource SkSurfaceBrush}"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.ShowDetailFailed), Mode=OneWay}">
                            <StackPanel Style="{StaticResource SkStatePanelStyle}">
                                <TextBlock
                                    Text="正文读取失败。"
                                    TextAlignment="Center"
                                    Style="{StaticResource SkDangerTextStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.DetailFailureText, Mode=OneWay}"
                                    TextAlignment="Center"
                                    Style="{StaticResource SkMutedTextStyle}"
                                    AutomationProperties.LiveSetting="Polite" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Button
                                        Content="重试这条"
                                        Command="{x:Bind ViewModel.RetryDetailCommand}"
                                        AutomationProperties.Name="重新读取当前选中剧情的正文" />
                                    <Button
                                        Content="刷新列表"
                                        Command="{x:Bind ViewModel.RefreshCommand}"
                                        AutomationProperties.Name="重新查询剧情列表" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
