<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SekaiSync.Desktop.Views.DatabasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SekaiSync.Desktop.Controls"
    xmlns:models="using:SekaiSync.Desktop.Models"
    xmlns:vm="using:SekaiSync.Desktop.ViewModels"
    mc:Ignorable="d">

    <Grid RowSpacing="12"
            KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="FindAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <InfoBar
                IsOpen="{x:Bind ViewModel.ShowDatabaseWarning, Mode=OneWay}" Severity="Warning"
                Title="原始表不可用" Message="{x:Bind ViewModel.DatabaseWarningText, Mode=OneWay}" IsClosable="False" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error"
                Title="读取失败" Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="重试" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <!-- 标签和控件、搜索框和按钮作为整体换行。 -->
            <controls:WrapPanel RowSpacing="8" ColumnSpacing="12">
                <Button
                    x:Name="BackButton" Content="返回概览" Style="{StaticResource SkWorkspaceButtonStyle}"
                    Visibility="Collapsed" Click="BackToOverview_Click" AutomationProperties.Name="返回数据源概览标签" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="TableLabel" Text="数据表" Margin="0" Style="{StaticResource SkInlineLabelStyle}" />
                    <ComboBox
                        Width="228" Style="{StaticResource SkWorkspaceComboBoxStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SelectedTable.Details, Mode=OneWay}"
                        AutomationProperties.LabeledBy="{x:Bind TableLabel}"
                        ItemsSource="{x:Bind ViewModel.Tables, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedTable, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DbTableOption">
                                <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Details}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox
                        x:Name="SearchBox" Width="224" Style="{StaticResource SkWorkspaceTextBoxStyle}"
                        PlaceholderText="搜索当前表" AutomationProperties.Name="在所选数据表中搜索"
                        AutomationProperties.HelpText="按回车或点击搜索执行。"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown" />
                    <Button Content="搜索" Style="{StaticResource SkWorkspaceAccentButtonStyle}" Command="{x:Bind ViewModel.SearchCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="PageSizeLabel" Text="每页行数" Margin="0" Style="{StaticResource SkInlineLabelStyle}" />
                    <ComboBox
                        Width="96" Style="{StaticResource SkWorkspaceComboBoxStyle}" ToolTipService.ToolTip="更改后从第一页读取"
                        AutomationProperties.LabeledBy="{x:Bind PageSizeLabel}"
                        ItemsSource="{x:Bind ViewModel.PageSizeOptions, Mode=OneTime}" SelectedItem="{x:Bind ViewModel.PageSize, Mode=TwoWay}" />
                </StackPanel>
                <Button
                    x:Name="RefreshButton" Content="刷新" Style="{StaticResource SkWorkspaceButtonStyle}"
                    Command="{x:Bind ViewModel.RefreshCommand}" />
                <ProgressRing
                    Width="24" Height="24" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoadingVisibility, Mode=OneWay}" />
            </controls:WrapPanel>

            <controls:WrapPanel RowSpacing="4" ColumnSpacing="12">
                <Border Style="{StaticResource SkUnknownChipStyle}" Padding="6,2">
                    <TextBlock Text="只读" Style="{StaticResource SkChipTextStyle}" Foreground="{ThemeResource SkUnknownBrush}" />
                </Border>
                <TextBlock Text="{x:Bind ViewModel.ReadOnlyContextText, Mode=OneWay}" Style="{StaticResource SkMutedTextStyle}" />
                <Button Content="表与查询说明" Style="{StaticResource SkWorkspaceButtonStyle}">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel MaxWidth="400" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.SelectedTable.Details, Mode=OneWay}" Style="{StaticResource SkBodyTextStyle}" IsTextSelectionEnabled="True" />
                                <TextBlock Text="搜索在当前表的预设列上执行 LIKE 匹配；按回车或点击搜索后读取。单元格显示摘要，选择行可查看完整字段。" Style="{StaticResource SkMutedTextStyle}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBlock
                    Text="{x:Bind ViewModel.HintText, Mode=OneWay}" Style="{StaticResource SkMutedTextStyle}"
                    AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind BoolToVisibility(ViewModel.HasHint), Mode=OneWay}" />
                <TextBlock
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource SkMutedTextStyle}"
                    Visibility="{x:Bind BoolToVisibility(ViewModel.ShowTableStatus), Mode=OneWay}" />
            </controls:WrapPanel>
        </StackPanel>

        <controls:WrapPanel Grid.Row="2" RowSpacing="8" ColumnSpacing="8" AutomationProperties.Name="数据分页">
            <Button Content="首页" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.FirstPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}" />
            <Button Content="上一页" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.PreviousPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}" />
            <Button Content="下一页" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.NextPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}" />
            <Button
                Content="末页" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.LastPageCommand}"
                IsEnabled="{x:Bind ViewModel.CanGoLastPage, Mode=OneWay}" AutomationProperties.HelpText="总行数已知时可跳到末页。" />
            <TextBlock Text="{x:Bind ViewModel.PagerText, Mode=OneWay}" Margin="4,0,0,0" Style="{StaticResource SkMutedTextStyle}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock
                Text="搜索结果总数未统计，末页不可用。" Style="{StaticResource SkMutedTextStyle}"
                Visibility="{x:Bind BoolToVisibility(ViewModel.HasActiveFilter), Mode=OneWay}" />
            <Button x:Name="ShowDetailsButton" Content="查看详情" Style="{StaticResource SkWorkspaceButtonStyle}"
                    Visibility="Collapsed" IsEnabled="{x:Bind ViewModel.HasSelectedRow, Mode=OneWay}" Click="ShowDetails_Click" />
            <Button x:Name="ReturnToListButton" Content="返回列表" Style="{StaticResource SkWorkspaceButtonStyle}"
                    Visibility="Collapsed" Click="ReturnToList_Click" />
        </controls:WrapPanel>

        <Grid x:Name="ContentGrid" Grid.Row="3" ColumnSpacing="12" SizeChanged="ContentGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RowsColumn" Width="2*" />
                <ColumnDefinition x:Name="DetailsColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="RowsPanel" Style="{StaticResource SkPanelStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 表头仅跟随行列表的横向偏移，不参与独立滚动或键盘导航。 -->
                    <ScrollViewer
                        x:Name="HeaderScroller" HorizontalAlignment="Left" IsTabStop="False" IsHitTestVisible="False"
                        HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled"
                        IsHorizontalScrollChainingEnabled="False" IsVerticalScrollChainingEnabled="False" ZoomMode="Disabled">
                        <Border Height="36" Background="{ThemeResource SkSurfaceMutedBrush}"
                                BorderBrush="{ThemeResource SkHairlineBrush}" BorderThickness="0,0,0,1">
                            <Grid x:Name="HeaderGrid" />
                        </Border>
                    </ScrollViewer>
                    <!-- 保持有限高度与 ItemsStackPanel 虚拟化；只有列表自身持有滚动条。 -->
                    <ListView
                        x:Name="RowsList" Grid.Row="1" Padding="0" BorderThickness="0" SelectionMode="Single"
                        ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                        AutomationProperties.Name="数据表行列表"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled"
                        ScrollViewer.ZoomMode="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="32" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <Border Grid.Row="1" Background="{ThemeResource SkSurfaceBrush}" Visibility="{x:Bind BoolToVisibility(ViewModel.IsEmptyByFilter), Mode=OneWay}">
                        <StackPanel Style="{StaticResource SkStatePanelStyle}">
                            <TextBlock Text="没有匹配行，换个关键词或清除搜索。" Style="{StaticResource SkMutedTextStyle}" TextAlignment="Center" />
                            <Button Content="清除搜索" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.ClearFilterCommand}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="{ThemeResource SkSurfaceBrush}" Visibility="{x:Bind BoolToVisibility(ViewModel.IsEmptyTable), Mode=OneWay}">
                        <StackPanel Style="{StaticResource SkStatePanelStyle}">
                            <TextBlock Text="这张表暂无数据，可选择其他表或回概览查看同步状态。" Style="{StaticResource SkMutedTextStyle}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="{ThemeResource SkSurfaceBrush}" Visibility="{x:Bind BoolToVisibility(ViewModel.IsReadFailed), Mode=OneWay}">
                        <StackPanel Style="{StaticResource SkStatePanelStyle}">
                            <TextBlock Text="读取失败，查看上方原因后重试。" Style="{StaticResource SkMutedTextStyle}" TextAlignment="Center" />
                            <Button Content="重试" Style="{StaticResource SkWorkspaceButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="DetailsPanel" Grid.Column="1" Style="{StaticResource SkPanelStyle}" Padding="16,12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}" Style="{StaticResource SkStrongTextStyle}" />
                    <TextBlock
                        Grid.Row="1" Text="选择一行查看字段" Style="{StaticResource SkMutedTextStyle}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasNoSelectedRow), Mode=OneWay}" />
                    <ScrollViewer
                        Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasSelectedRow), Mode=OneWay}">
                        <StackPanel Spacing="8" Margin="0,0,8,0">
                            <TextBlock
                                Text="{x:Bind ViewModel.DetailHintText, Mode=OneWay}" Style="{StaticResource SkMutedTextStyle}"
                                Visibility="{x:Bind BoolToVisibility(ViewModel.HasDetailHint), Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RowDetail, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DbDetailField">
                                        <StackPanel Margin="0,0,0,12" Spacing="4">
                                            <controls:WrapPanel ColumnSpacing="8" RowSpacing="4">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource SkStrongTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <Border Style="{StaticResource SkUnknownChipStyle}" Padding="6,2" Visibility="{x:Bind JsonBadge}">
                                                    <TextBlock Text="JSON" Style="{StaticResource SkChipTextStyle}" Foreground="{ThemeResource SkUnknownBrush}" />
                                                </Border>
                                            </controls:WrapPanel>
                                            <TextBlock
                                                Text="{x:Bind Value}" Style="{StaticResource SkProseTextStyle}" TextWrapping="Wrap"
                                                FontFamily="Consolas, Cascadia Mono, Courier New" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
