<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SekaiSync.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!--
              合并顺序即查找优先级：后合并的字典先被查到。
              Brand.xaml 必须排在 XamlControlsResources 之后，否则覆盖会被框架字典压住
              （原因与实测见 Styles/Brand.xaml 顶部注释）。
            -->
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Sizing.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Brand.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 表格行高：桌面密集视图允许紧凑，但不低于可读字号。 -->
            <x:Double x:Key="DbRowHeight">32</x:Double>
            <x:Double x:Key="DbHeaderHeight">36</x:Double>

            <!-- Db* 是迁移期别名，取值统一走 Signal Stage 的角色样式。 -->
            <Style x:Key="DbHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SkTableHeaderTextStyle}" />
            <Style x:Key="DbCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SkTableCellTextStyle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
