    <Compile Include="..\..\Services\ProgressService.cs" Link="Services\ProgressService.cs" />
    <Compile Include="..\..\Services\NewsService.cs" Link="Services\NewsService.cs" />
    <Compile Include="..\..\Services\TextRenderer.cs" Link="Services\TextRenderer.cs" />
